# Backend-only credentials. Never place SUPABASE_SERVICE_ROLE_KEY in VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
FRONTEND_URL=http://localhost:5173
LOCAL_AUTH_BYPASS=false
# Comma-separated, explicitly configured public boards only.
# Example format: greenhouse:board_slug,lever:company_slug,ashby:board_slug
EMPLOYER_BOARDS=
DISCORD_WEBHOOK_URL=
ADMIN_API_TOKEN=
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend public values. The Supabase anon key is safe only with RLS enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
